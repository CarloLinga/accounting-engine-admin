@page "/financial-statements"

<PageTitle>Financial Statements</PageTitle>

<RadzenStack Gap="1rem" class="statements-page">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="0.75rem">
        <div>
            <h1 class="page-title">Financial Statements</h1>
            <p class="page-subtitle">Balance sheet, income statement and cash flow statement.</p>
        </div>
    </RadzenStack>

    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="0.75rem" Wrap="FlexWrap.Wrap">
            <RadzenStack Gap="0.25rem" Style="min-width: 180px; flex: 1 1 180px;">
                <RadzenLabel Text="Balance sheet as of (optional)" />
                <RadzenDatePicker TValue="DateTime?" @bind-Value="asOfDate" DateFormat="yyyy-MM-dd" ShowTime="false" Name="fsAsOf" Style="width:100%" />
            </RadzenStack>
            <RadzenStack Gap="0.25rem" Style="min-width: 180px; flex: 1 1 180px;">
                <RadzenLabel Text="Period from (optional)" />
                <RadzenDatePicker TValue="DateTime?" @bind-Value="fromDate" DateFormat="yyyy-MM-dd" ShowTime="false" Name="fsFrom" Style="width:100%" />
            </RadzenStack>
            <RadzenStack Gap="0.25rem" Style="min-width: 180px; flex: 1 1 180px;">
                <RadzenLabel Text="Period to (optional)" />
                <RadzenDatePicker TValue="DateTime?" @bind-Value="toDate" DateFormat="yyyy-MM-dd" ShowTime="false" Name="fsTo" Style="width:100%" />
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenCheckBox @bind-Value="includeInactive" TValue="bool" Name="fsIncludeInactive" />
                <RadzenLabel Text="Include inactive" />
            </RadzenStack>
            <RadzenButton Text="Load" Icon="refresh" Click="@LoadAsync" ButtonStyle="ButtonStyle.Primary" />
        </RadzenStack>
    </RadzenCard>

    @if (!string.IsNullOrEmpty(loadError))
    {
        <RadzenCard class="page-error">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                <RadzenIcon Icon="error" />
                <div style="flex: 1 1 auto;">@loadError</div>
                <RadzenButton Text="Retry" Size="ButtonSize.Small" Click="@LoadAsync" ButtonStyle="ButtonStyle.Secondary" />
            </RadzenStack>
        </RadzenCard>
    }

    @if (isLoading)
    {
        <RadzenCard><p><em>Loading financial statements...</em></p></RadzenCard>
    }
    else
    {
        <RadzenTabs class="statements-tabs">
            <Tabs>
                <RadzenTabsItem Text="Balance Sheet">
                    <BalanceSheetTab BalanceSheet="@balanceSheet" />
                </RadzenTabsItem>
                <RadzenTabsItem Text="Income Statement">
                    <IncomeStatementTab IncomeStatement="@incomeStatement" />
                </RadzenTabsItem>
                <RadzenTabsItem Text="Cash Flow">
                    <CashFlowTab CashFlow="@cashFlow" />
                </RadzenTabsItem>
            </Tabs>
        </RadzenTabs>
    }
</RadzenStack>
