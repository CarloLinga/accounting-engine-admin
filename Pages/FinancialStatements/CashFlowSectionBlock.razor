<RadzenStack Gap="0.4rem" class="stk-block">
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" class="fs-section-head">
        <h3>@Section.Title</h3>
        <strong class="stk-amount">@ReportFormats.MoneySigned(Section.Subtotal)</strong>
    </RadzenStack>

    <RadzenDataGrid TItem="CashFlowRow" Data="@rows" AllowPaging="false" AllowSorting="false" AllowFiltering="false" class="fs-section-grid">
        <Columns>
            <RadzenDataGridColumn TItem="CashFlowRow" Title="Item" Width="70%">
                <Template Context="row">
                    <span class="@ItemCellCss(row)" @onclick="() => OpenLedger(row.Adjustment.AccountCode)">
                        @if (!string.IsNullOrEmpty(row.Adjustment.AccountCode))
                        {
                            <span class="stk-code">@row.Adjustment.AccountCode</span>
                        }
                        <span class="stk-name">@row.Adjustment.Label</span>
                    </span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="CashFlowRow" Title="Amount" Width="30%" TextAlign="TextAlign.Right">
                <Template Context="row">
                    <span class="stk-amount @CashFlowRendering.AmountCss(row.Adjustment)">@ReportFormats.MoneySigned(row.Adjustment.Amount)</span>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</RadzenStack>