<EditForm Model="@Model" OnValidSubmit="@SaveAsync">
    <DataAnnotationsValidator />
    <RadzenStack Gap="0.75rem">
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="dialog-error">@error</div>
        }

        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem" Wrap="FlexWrap.Wrap">
            <RadzenStack Gap="0.25rem" Style="flex: 1 1 200px;">
                <RadzenLabel Text="Source type" />
                <RadzenTextBox Name="SourceType" @bind-Value="Model.SourceType" Disabled="@(!IsCreate)" Style="width:100%" />
                <ValidationMessage For="@(() => Model.SourceType)" />
            </RadzenStack>
            <RadzenStack Gap="0.25rem" Style="flex: 1 1 200px;">
                <RadzenLabel Text="Reference" />
                <RadzenTextBox Name="Reference" @bind-Value="Model.Reference" Placeholder="e.g. GJ-2026-0001" Style="width:100%" />
                <ValidationMessage For="@(() => Model.Reference)" />
            </RadzenStack>
            <RadzenStack Gap="0.25rem" Style="flex: 1 1 180px;">
                <RadzenLabel Text="Posting date" />
                <RadzenDatePicker TValue="DateTime?" @bind-Value="Model.PostedOn" DateFormat="yyyy-MM-dd" ShowTime="false" Name="PostedOn" Style="width:100%" />
                <ValidationMessage For="@(() => Model.PostedOn)" />
            </RadzenStack>
        </RadzenStack>

        <RadzenStack Gap="0.25rem">
            <RadzenLabel Text="Description (optional)" />
            <RadzenTextBox Name="Description" @bind-Value="Model.Description" Placeholder="What this entry is for" Style="width:100%" />
        </RadzenStack>

        <RadzenStack Gap="0.5rem" class="gj-lines">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                <RadzenLabel Text="Journal lines" />
                <RadzenButton Text="Add line" Icon="add" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary" Click="@AddLine" ButtonType="ButtonType.Button" />
            </RadzenStack>

            <RadzenDataGrid TItem="JournalLineFormModel" Data="@Model.Lines" AllowPaging="false" AllowSorting="false" AllowFiltering="false" AllowColumnResize="true" class="gj-lines-grid">
                <Columns>
                    <RadzenDataGridColumn TItem="JournalLineFormModel" Title="#" Width="55px" TextAlign="TextAlign.Center">
                        <Template Context="line">@LineNumber(line)</Template>
                        <FooterTemplate>Totals</FooterTemplate>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="JournalLineFormModel" Title="Account" Width="240px">
                        <Template Context="line">
                            <RadzenDropDown @bind-Value="line.AccountCode" Data="@postableAccounts" TextProperty="Code" ValueProperty="Code" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowClear="true" Placeholder="Select account..." Style="width:100%">
                                <Template Context="account">@account.Code - @account.Name</Template>
                            </RadzenDropDown>
                            <ValidationMessage For="@(() => line.AccountCode)" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="JournalLineFormModel" Title="Debit" Width="135px" TextAlign="TextAlign.Right">
                        <Template Context="line">
                            <RadzenNumeric TValue="decimal?" @bind-Value="line.Debit" Format="N2" ShowUpDown="false" class="gj-amount-input" Style="width:100%" />
                            <ValidationMessage For="@(() => line.Debit)" />
                        </Template>
                        <FooterTemplate><span class="gj-footer-number">@Model.TotalDebits.ToString("N2")</span></FooterTemplate>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="JournalLineFormModel" Title="Credit" Width="135px" TextAlign="TextAlign.Right">
                        <Template Context="line">
                            <RadzenNumeric TValue="decimal?" @bind-Value="line.Credit" Format="N2" ShowUpDown="false" class="gj-amount-input" Style="width:100%" />
                            <ValidationMessage For="@(() => line.Credit)" />
                        </Template>
                        <FooterTemplate><span class="gj-footer-number">@Model.TotalCredits.ToString("N2")</span></FooterTemplate>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="JournalLineFormModel" Title="Description" MinWidth="180px">
                        <Template Context="line"><RadzenTextBox @bind-Value="line.Description" Style="width:100%" /></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="JournalLineFormModel" Title="" Width="58px" Sortable="false" Filterable="false" TextAlign="TextAlign.Center">
                        <Template Context="line"><RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Click="@(() => RemoveLine(line))" ButtonType="ButtonType.Button" title="Remove line" /></Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenStack>

        @if (!Model.IsBalanced)
        {
            <div class="gj-totals is-unbalanced">Debit and credit totals are not balanced.</div>
        }

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" Style="margin-top: 0.5rem;">
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@Cancel" Disabled="@saving" ButtonType="ButtonType.Button" />
            <RadzenButton Text="@(saving ? "Saving..." : (IsCreate ? "Post entry" : "Save changes"))" ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Submit" Disabled="@saving" Icon="check" />
        </RadzenStack>
    </RadzenStack>
</EditForm>
