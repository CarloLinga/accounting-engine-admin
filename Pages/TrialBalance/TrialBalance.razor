@page "/trial-balance"

<PageTitle>Trial Balance</PageTitle>

<RadzenStack Gap="1rem" class="trial-balance-page">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="0.75rem">
        <div>
            <h1 class="page-title">Trial Balance</h1>
            <p class="page-subtitle">Opening, period and closing debit/credit totals per account.</p>
        </div>
        @if (report is not null)
        {
            <span class="trial-balance-badge @(report.IsBalanced ? "is-balanced" : "is-unbalanced")">
                @(report.IsBalanced ? "Balanced" : "Not balanced")
            </span>
        }
    </RadzenStack>

    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="0.75rem" Wrap="FlexWrap.Wrap">
            <RadzenStack Gap="0.25rem" Style="min-width: 180px; flex: 1 1 180px;">
                <RadzenLabel Text="As of (optional)" />
                <RadzenDatePicker TValue="DateTime?" @bind-Value="asOfDate" DateFormat="yyyy-MM-dd" ShowTime="false" Name="tbAsOf" Style="width:100%" />
            </RadzenStack>
            <RadzenStack Gap="0.25rem" Style="min-width: 140px; flex: 1 1 140px;">
                <RadzenLabel Text="Fiscal year (optional)" />
                <RadzenNumeric TValue="int?" @bind-Value="fiscalYear" Placeholder="e.g. 2026" Style="width:100%" />
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenCheckBox @bind-Value="includeInactive" TValue="bool" Name="tbIncludeInactive" />
                <RadzenLabel Text="Include inactive" />
            </RadzenStack>
            <RadzenButton Text="Load" Icon="refresh" Click="@LoadAsync" ButtonStyle="ButtonStyle.Primary" />
        </RadzenStack>
    </RadzenCard>

    @if (!string.IsNullOrEmpty(loadError))
    {
        <RadzenCard class="page-error">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                <RadzenIcon Icon="error" />
                <div style="flex: 1 1 auto;">@loadError</div>
                <RadzenButton Text="Retry" Size="ButtonSize.Small" Click="@LoadAsync" ButtonStyle="ButtonStyle.Secondary" />
            </RadzenStack>
        </RadzenCard>
    }

    <RadzenCard class="trial-balance-card">

        @if (isLoading)
        {
            <p><em>Loading trial balance...</em></p>
        }
        else if (report is not null)
        {
            <RadzenStack Orientation="Orientation.Horizontal" Gap="1.25rem" Wrap="FlexWrap.Wrap" class="trial-balance-meta">
                <span>Fiscal year <strong>@report.FiscalYear</strong></span>
                <span>Period from <strong>@report.PeriodStart.ToString("dd MMM yyyy")</strong></span>
                <span>As of <strong>@report.AsOf.ToString("dd MMM yyyy")</strong></span>
                @if (report.IncludeInactiveAccounts)
                {
                    <span>Includes inactive accounts</span>
                }
            </RadzenStack>

            @if (report.Lines.Count == 0)
            {
                <p>No accounts with activity for the selected filters.</p>
            }
            else
            {
                <RadzenDataGrid TItem="TrialBalanceLine" Data="@report.Lines" AllowPaging="true" PageSize="20" AllowSorting="true" AllowFiltering="true" class="trial-balance-grid">
                    <Columns>
                        <RadzenDataGridColumn TItem="TrialBalanceLine" Property="AccountCode" Title="Code" Width="100px" />
                        <RadzenDataGridColumn TItem="TrialBalanceLine" Property="AccountName" Title="Account name" />
                        <RadzenDataGridColumn TItem="TrialBalanceLine" Property="AccountType" Title="Type" Width="120px" Filterable="false">
                            <Template Context="line">
                                <span class="account-badge @TypeBadge(line)">@AccountLabels.For(line.AccountType)</span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TrialBalanceLine" Title="Opening balance" Width="140px" Sortable="false" Filterable="false" TextAlign="TextAlign.Right">
                            <Template Context="line">@ReportFormats.Money(line.OpeningBalance)</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TrialBalanceLine" Title="Period debit" Width="130px" Sortable="false" Filterable="false" TextAlign="TextAlign.Right">
                            <Template Context="line">@ReportFormats.Money(line.PeriodDebit)</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TrialBalanceLine" Title="Period credit" Width="130px" Sortable="false" Filterable="false" TextAlign="TextAlign.Right">
                            <Template Context="line">@ReportFormats.Money(line.PeriodCredit)</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TrialBalanceLine" Title="Closing balance" Width="140px" Sortable="false" Filterable="false" TextAlign="TextAlign.Right">
                            <Template Context="line">@ReportFormats.Money(line.ClosingBalance)</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TrialBalanceLine" Title="" Width="70px" Sortable="false" Filterable="false">
                            <Template Context="line">
                                <RadzenButton Icon="menu_book" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" title="View ledger" Click="@(() => OpenLedgerAsync(line))" />
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>

                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="2rem" class="trial-balance-totals">
                    <span>Total debit: <strong>@ReportFormats.MoneySigned(report.TotalDebits)</strong></span>
                    <span>Total credit: <strong>@ReportFormats.MoneySigned(report.TotalCredits)</strong></span>
                </RadzenStack>
            }
        }
    </RadzenCard>
</RadzenStack>
